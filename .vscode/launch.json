{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TMUF + Always Official (native Debug)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${input:tmufGameDirectory}/TmForever.exe",
      "cwd": "${input:tmufGameDirectory}",
      "args": [
      ],
      "preLaunchTask": "Always Official: prepare TMUF debugging",
      "stopAtEntry": false,
      "symbolSearchPath": "${workspaceFolder}\\build\\Debug",
      "requireExactSource": true,
      "logging": {
        "moduleLoad": true
      }
    }
  ],
  "inputs": [
    {
      "id": "tmufGameDirectory",
      "type": "promptString",
      "description": "TMUF installation folder for debugging (contains TmForever.exe)",
      "default": "C:/Program Files (x86)/TmUnitedForever"
    }
  ]
}
