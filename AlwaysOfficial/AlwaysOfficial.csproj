<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup Label="Compilation">
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup Label="Assembly metadata">
        <RootNamespace>AlwaysOfficial</RootNamespace>
        <AssemblyName>AlwaysOfficial</AssemblyName>
        <Version>0.1.1</Version>
        <Version Condition="'$(GITHUB_REF_TYPE)' == 'tag' and $([System.String]::Copy('$(GITHUB_REF_NAME)').StartsWith('v'))">$([System.String]::Copy('$(GITHUB_REF_NAME)').Substring(1))</Version>
        <AssemblyTitle>Always Official</AssemblyTitle>
        <Product>Always Official</Product>
        <Company>BigBang1112</Company>
        <Authors>BigBang1112</Authors>
    </PropertyGroup>

    <PropertyGroup Label="Native AOT">
        <RuntimeIdentifier>win-x86</RuntimeIdentifier>
        <PublishAot>true</PublishAot>
        <NativeLib>Shared</NativeLib>
        <SelfContained>true</SelfContained>
        <InvariantGlobalization>true</InvariantGlobalization>
        <UseSystemResourceKeys>true</UseSystemResourceKeys>
        <StackTraceSupport Condition="'$(Configuration)' == 'Release'">false</StackTraceSupport>
        <DebuggerSupport Condition="'$(Configuration)' == 'Release'">false</DebuggerSupport>
        <EventSourceSupport>false</EventSourceSupport>
        <OptimizationPreference>Size</OptimizationPreference>
    </PropertyGroup>

    <PropertyGroup Label="Native shim">
        <ShimSource>$(MSBuildThisFileDirectory)native\shim.c</ShimSource>
        <ShimObject>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\shim.obj</ShimObject>
        <ShimCompilerFlags Condition="'$(Configuration)' == 'Debug'">/Od /Z7</ShimCompilerFlags>
        <ShimCompilerFlags Condition="'$(Configuration)' != 'Debug'">/O2</ShimCompilerFlags>
    </PropertyGroup>

    <ItemGroup>
        <NativeLibrary Include="$(ShimObject)" />
        <LinkerArg Include="/ENTRY:ModEntry" />
    </ItemGroup>

    <!--
      Output files for both distribution modes; where they are copied is up to the user. Needs the
      .NET 10 SDK and Visual Studio (or its Build Tools) with "Desktop development with C++" (Native AOT
      links with link.exe, cl.exe compiles native\shim.c).

        dotnet publish AlwaysOfficial -c Release [-p:Version=0.1.0] [-o <dir>]
            bin\Release\net10.0\win-x86\publish\ (or <dir>): AlwaysOfficial.dll and d3d9.dll (standalone
            loader), with PDBs.
            dist\ (repository root): those DLLs, AlwaysOfficial-modloader.zip and
            AlwaysOfficial-standalone.zip.

        dotnet publish AlwaysOfficial -c Release -p:NativeTestBuild=true
            bin\Release-NativeTests\net10.0\win-x86\publish\: the same hooks plus a test-only export, for
            AlwaysOfficial.Tests. Separate bin\ and obj\ folders keep it from overwriting the real build.
    -->
    <PropertyGroup Label="Native tests" Condition="'$(NativeTestBuild)' == 'true'">
        <DefineConstants>$(DefineConstants);NATIVE_TESTS</DefineConstants>
        <OutputPath>bin\$(Configuration)-NativeTests\</OutputPath>
        <IntermediateOutputPath>obj\$(Configuration)-NativeTests\</IntermediateOutputPath>
    </PropertyGroup>

    <PropertyGroup Label="Packaging">
        <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\'))</RepositoryRoot>
        <DistDir>$(RepositoryRoot)dist\</DistDir>
        <AlwaysOfficialPackageStaging>$(MSBuildProjectDirectory)\obj\$(Configuration)\package\</AlwaysOfficialPackageStaging>
    </PropertyGroup>

    <!-- Generate the displayed assembly version at build time instead of retaining runtime reflection. -->
    <Target Name="GenerateModVersion" BeforeTargets="CoreCompile" DependsOnTargets="GetAssemblyVersion;InitializeSourceControlInformation">
        <PropertyGroup>
            <_ModVersion>$([System.Version]::Parse('$(AssemblyVersion)').ToString(3))</_ModVersion>
            <_ModVersionFile>$(IntermediateOutputPath)ModInfo.Version.g.cs</_ModVersionFile>
        </PropertyGroup>
        <WriteLinesToFile File="$(_ModVersionFile)" Lines="namespace AlwaysOfficial { public static partial class ModInfo { private const string BuildVersion = &quot;$(_ModVersion)&quot;%3B private const string BuildAssemblyVersion = &quot;$(AssemblyVersion)&quot;%3B private const string BuildCommit = &quot;$(SourceRevisionId)&quot;%3B } }" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <Compile Include="$(_ModVersionFile)" />
            <FileWrites Include="$(_ModVersionFile)" />
        </ItemGroup>
    </Target>

    <UsingTask TaskName="AlwaysOfficialPrependPath" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <Folder ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Code Type="Fragment" Language="cs"><![CDATA[
                var path = Environment.GetEnvironmentVariable("PATH") ?? "";
                if (!path.Split(';').Any(p => string.Equals(p.TrimEnd('\\'), Folder.TrimEnd('\\'), StringComparison.OrdinalIgnoreCase)))
                {
                    Environment.SetEnvironmentVariable("PATH", Folder + ";" + path);
                }
            ]]></Code>
        </Task>
    </UsingTask>

    <UsingTask TaskName="AlwaysOfficialCheckGameFolder" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <Folder ParameterType="System.String" Required="true" />
            <AssemblyName ParameterType="System.String" Required="true" />
            <Product ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System.Diagnostics" />
            <Code Type="Method" Language="cs"><![CDATA[
            public override bool Execute()
            {
                var running = Process.GetProcessesByName("TmForever");
                if (running.Length > 0)
                {
                    Log.LogError("TrackMania (TmForever.exe) is running. Close the game before publishing into " + Folder);
                }

                foreach (var process in running)
                {
                    process.Dispose();
                }

                var proxy = Path.Combine(Folder, "d3d9.dll");
                if (File.Exists(proxy) && FileVersionInfo.GetVersionInfo(proxy).ProductName != Product &&
                    !Encoding.ASCII.GetString(File.ReadAllBytes(proxy)).Contains("AlwaysOfficialStandaloneProxy"))
                {
                    Log.LogError(proxy + " belongs to another mod (it is not the Always Official standalone loader). Left alone; remove it or use the ModLoader instead.");
                }

                var mod = Path.Combine(Folder, AssemblyName + ".dll");
                if (File.Exists(mod) && FileVersionInfo.GetVersionInfo(mod).ProductName != Product)
                {
                    Log.LogError(mod + " is not " + Product + ". Left alone; remove it first.");
                }

                return !Log.HasLoggedErrors;
            }
            ]]></Code>
        </Task>
    </UsingTask>

    <!-- Publishing into a game folder (-o <folder with TmForever.exe>, as the VS Code debug task does) must
         not overwrite another mod's d3d9.dll or files the running game has loaded. Runs before the build,
         so nothing is compiled or written when a check fails. -->
    <Target Name="AlwaysOfficialCheckGameFolder" BeforeTargets="Build;PrepareForPublish" Condition="'$(NativeTestBuild)' != 'true' and Exists('$([MSBuild]::EnsureTrailingSlash($(PublishDir)))TmForever.exe')">
        <AlwaysOfficialCheckGameFolder Folder="$(PublishDir)" AssemblyName="$(AssemblyName)" Product="$(Product)" />
        <Message Importance="high" Text="Publishing into game folder $(PublishDir): game closed, no foreign d3d9.dll or AlwaysOfficial.dll." />
    </Target>

    <!-- Visual Studio 2026's vcvarsall.bat calls vswhere.exe by name; the AOT targets run it through
         findvcvarsall.bat and fail to find link.exe unless vswhere's folder is on PATH. -->
    <Target Name="AlwaysOfficialFindVsWhere" BeforeTargets="SetupOSSpecificProps" Condition="'$(OS)' == 'Windows_NT'">
        <PropertyGroup>
            <_AlwaysOfficialVsInstaller>$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer</_AlwaysOfficialVsInstaller>
        </PropertyGroup>
        <Error Condition="!Exists('$(_AlwaysOfficialVsInstaller)\vswhere.exe')" Text="vswhere.exe not found in $(_AlwaysOfficialVsInstaller). Install Visual Studio (or the Build Tools) with C++." />
        <AlwaysOfficialPrependPath Folder="$(_AlwaysOfficialVsInstaller)" />
    </Target>

    <!-- ModLoader and standalone packages, plus loose files for development and the release. -->
    <Target Name="AlwaysOfficialPackage" AfterTargets="Publish" DependsOnTargets="BuildStandaloneProxy" Condition="'$(NativeTestBuild)' != 'true'">
        <PropertyGroup>
            <_ModLoaderStaging>$(AlwaysOfficialPackageStaging)modloader\</_ModLoaderStaging>
            <_StandaloneStaging>$(AlwaysOfficialPackageStaging)standalone\</_StandaloneStaging>
        </PropertyGroup>
        <ItemGroup>
            <_DistFile Include="$(PublishDir)$(AssemblyName).dll;$(PublishDir)d3d9.dll" />
            <_DistFile Include="$(PublishDir)$(AssemblyName).pdb" Condition="Exists('$(PublishDir)$(AssemblyName).pdb')" />
        </ItemGroup>

        <RemoveDir Directories="$(AlwaysOfficialPackageStaging)" />
        <Copy SourceFiles="$(PublishDir)$(AssemblyName).dll" DestinationFolder="$(_ModLoaderStaging)" />
        <Copy SourceFiles="$(PublishDir)$(AssemblyName).dll;$(PublishDir)d3d9.dll" DestinationFolder="$(_StandaloneStaging)" />

        <Copy SourceFiles="@(_DistFile)" DestinationFolder="$(DistDir)" />
        <ZipDirectory SourceDirectory="$(_ModLoaderStaging)" DestinationFile="$(DistDir)$(AssemblyName)-modloader.zip" Overwrite="true" />
        <ZipDirectory SourceDirectory="$(_StandaloneStaging)" DestinationFile="$(DistDir)$(AssemblyName)-standalone.zip" Overwrite="true" />
        <Message Importance="high" Text="$(AssemblyName) $(Version) packaged in $(DistDir)" />
    </Target>

    <Target Name="CompileModShim" BeforeTargets="LinkNative" DependsOnTargets="SetupOSSpecificProps" Inputs="$(ShimSource);$(MSBuildProjectFullPath)" Outputs="$(ShimObject)">
        <Error Condition="!Exists('$(_CppToolsDirectory)cl.exe')" Text="cl.exe not found in '$(_CppToolsDirectory)'. Install Visual Studio (or its Build Tools) with the MSVC x86/x64 build tools." />
        <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(ShimObject)'))" />
        <Exec Command="&quot;$(_CppToolsDirectory)cl.exe&quot; /nologo /c $(ShimCompilerFlags) /GS- /Zl /W4 /WX /Fo&quot;$(ShimObject)&quot; &quot;$(ShimSource)&quot;" />
    </Target>
    <Target Name="BuildStandaloneProxy" DependsOnTargets="SetupOSSpecificProps" Condition="'$(NativeTestBuild)' != 'true'">
        <Exec Command="&quot;$(_CppToolsDirectory)cl.exe&quot; /nologo /LD /DSTANDALONE_PROXY $(ShimCompilerFlags) /GS- /Zl /W4 /WX /Fo&quot;$(ShimObject).proxy.obj&quot; /Fe&quot;$(PublishDir)d3d9.dll&quot; &quot;$(ShimSource)&quot; /link /NODEFAULTLIB /ENTRY:ProxyEntry @(AdditionalNativeLibraryDirectories->'/LIBPATH:&quot;%(Identity)&quot;', ' ') kernel32.lib /PDB:&quot;$(PublishDir)d3d9.pdb&quot; /IMPLIB:&quot;$(ShimObject).proxy.lib&quot; /INCREMENTAL:NO" />
    </Target>
</Project>
