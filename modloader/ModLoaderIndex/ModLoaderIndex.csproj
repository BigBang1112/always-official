<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>AlwaysOfficial.ModLoaderIndex</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- The feed template (schema, product name and description) shared by both channels. -->
        <None Include="..\index.json" Link="index.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
