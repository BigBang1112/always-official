<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RuntimeIdentifier>win-x86</RuntimeIdentifier>
        <PlatformTarget>x86</PlatformTarget>
        <SelfContained>true</SelfContained>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../../src/AlwaysOfficial/OfficialSession.cs" Link="OfficialSession.cs" />
        <Compile Include="../../src/AlwaysOfficial/HeldButtons.cs" Link="HeldButtons.cs" />
        <Compile Include="../../src/AlwaysOfficial/Core/CallPatch.cs" Link="CallPatch.cs" />
        <Compile Include="../../src/AlwaysOfficial/Core/UserData.cs" Link="UserData.cs" />
        <Compile Include="../../src/AlwaysOfficial/Core/Memory.cs" Link="Memory.cs" />
        <Compile Include="../../src/AlwaysOfficial/Core/Win32.cs" Link="Win32.cs" />
    </ItemGroup>
        
    <ItemGroup>
        <PackageReference Include="TUnit" Version="1.81.10" />
    </ItemGroup>
</Project>
